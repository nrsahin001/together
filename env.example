# Where your Secure Auth API lives (the same value as ISSUER on the auth server). No trailing slash.
OIDC_ISSUER=https://app.najibur.me

# From the developer portal (Register app -> Together). Treat the secret like a password.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# This app's public address. The redirect URI is PUBLIC_URL + "/" unless OIDC_REDIRECT_URI says otherwise,
# and it must match what you registered in the portal EXACTLY.
PUBLIC_URL=https://together-4546.onrender.com
# OIDC_REDIRECT_URI=https://together-4546.onrender.com/

# Random 32+ characters: python -c "import secrets;print(secrets.token_hex(32))"   (signs the login cookies)
SESSION_SECRET=

# Optional
# OIDC_SCOPE=openid profile          # must be a subset of the scopes registered for the app (e.g. add birthdate)
# SESSION_DAYS=7
# AUTH_PROVIDER_NAME=Secure Auth     # name shown on the login button
# ACCOUNT_SIGNUP_URL=https://YOURUSER.github.io/auth-web/signup.html   # shows a "Create one" link
# TRUST_PROXY=1                      # 1 on Render (reads the client IP from X-Forwarded-For)
